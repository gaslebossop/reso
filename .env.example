# Le moteur Prisme. Laisser l'adresse deployee par defaut ; pour travailler
# contre un moteur local, mettre l'IP DU POSTE (pas localhost : sur un
# telephone, localhost designe le telephone lui-meme) — p.ex.
#   EXPO_PUBLIC_PRISME_URL=http://192.168.1.41:4400
EXPO_PUBLIC_PRISME_URL=https://reso.twitninf.duckdns.org

# Import du gout depuis Spotify a l'onboarding (facultatif).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
